# VG Learner Portal settings
# ----------------------------------------------------------------------------
# 1. Copy this file to ".env" in the same folder (next to app.py).
# 2. Fill in ONE email provider block below (remove the # in front of its lines).
# 3. Test:   python auth.py test-email --to you@example.com
# 4. Restart: python app.py
# .env is in .gitignore: never commit it, it contains your mail password.
# Values set in the real environment ($env:... / docker -e) override this file.

# --- Public address of the portal (used in the links inside the emails) ------
PUBLIC_URL=http://localhost:5000
# Example in production: PUBLIC_URL=https://learn.example.com

# --- Sender name/address shown to users ---------------------------------------
# SMTP_FROM=VG Learner Portal <no-reply@example.com>

# ============================================================================
# EMAIL PROVIDER: fill in ONE block
# ============================================================================

# --- Gmail / Google Workspace ------------------------------------------------
# Needs 2-Step Verification ON, then create an App password at
# https://myaccount.google.com/apppasswords (16 characters, no spaces).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM=VG Learner Portal <you@example.com>

# --- Outlook.com / Microsoft 365 ---------------------------------------------
# For Microsoft 365 an admin must enable "Authenticated SMTP" for the mailbox.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-mailbox-password
# SMTP_FROM=you@example.com

# --- Amazon SES (recommended on AWS) ------------------------------------------
# Verify the sender address/domain in SES, then create SMTP credentials
# (SES console > SMTP settings). New SES accounts can only send to verified
# addresses until you request production access.
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=AKIAXXXXXXXXXXXXXXXX
# SMTP_PASSWORD=your-ses-smtp-password
# SMTP_FROM=VG Learner Portal <no-reply@yourdomain.com>

# --- Brevo (free tier) ---------------------------------------------------------
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login
# SMTP_PASSWORD=your-brevo-smtp-key
# SMTP_FROM=VG Learner Portal <no-reply@yourdomain.com>

# --- Providers that use SSL on port 465 ---------------------------------------
# SMTP_PORT=465        (SSL is switched on automatically for 465)

# ============================================================================
# Optional: sign-up and login behaviour
# ============================================================================
# SIGNUP_MODE=open                 # open | approval | closed
# SIGNUP_DOMAINS=example.com       # only these email domains can sign up
# EMAIL_VERIFICATION=true          # new users must verify their email first
# VERIFY_TOKEN_HOURS=24
# RESET_TOKEN_MINUTES=30
# REMEMBER_ME_DAYS=30
# ADMIN_EMAILS=admin@vglearner.local
# IMDS_DISABLED=true               # set when not running on EC2 (auto-true on Vercel/Lambda)

# ============================================================================
# Optional: serverless (Vercel, AWS Lambda, etc.)
# ============================================================================
# AUTH_DB defaults to /tmp/auth.db on Vercel/Lambda automatically (BASE_DIR is
# read-only there). /tmp is EPHEMERAL: it resets on every cold start and is not
# shared across instances, so accounts/sessions/audit history do not persist
# across deploys or even between some requests. Point AUTH_DB at a real
# persistent database (e.g. via an adapter to PostgreSQL) for production use.
# AUTH_DB=/tmp/auth.db
#
# AWS_MONITORING_ENABLED and LAB_MONITOR_ENABLED both default to false on
# Vercel/Lambda: there is no EC2 instance role for boto3 to use, and a
# long-running background thread does not fit a serverless function. Leave
# them unset unless you explicitly want the DynamoDB lab-status tier checked
# from Vercel with your own IAM user credentials below.
# AWS_MONITORING_ENABLED=true
# LAB_MONITOR_ENABLED=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
